# Public browser configuration. Copy this file to .env.local, fill in these two values, then restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A local demo is allowed on localhost only, until Supabase is connected.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=true
# Telegram bot token, chat ID, and service-role key go in Supabase Edge Function secrets,
# never in any NEXT_PUBLIC variable. See SETUP.md.
